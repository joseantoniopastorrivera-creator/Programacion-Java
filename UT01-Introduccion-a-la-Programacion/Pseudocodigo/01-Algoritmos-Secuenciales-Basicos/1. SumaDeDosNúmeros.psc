Algoritmo SumaDeDosNúmeros
	//Fecha 18 Sept
	//Autor JAPR
	//Suma de dos números solicitados por el usuario
	
	//Parte declarativa
	Definir numero1 Como Real
	Definir numero2 Como Real
	Definir suma Como Real
	
	//Cuerpo del Algoritmo 
	
	Escribir "Este algoritmo suma dos números. Indique el primer número:"
	leer numero1
	
	Escribir "Indique el segundo número:"
	leer numero2
	
	suma <- numero1 + numero2
	Escribir "El resultado de la suma de ",numero1," y ",numero2, " es:", suma
	
FinAlgoritmo
