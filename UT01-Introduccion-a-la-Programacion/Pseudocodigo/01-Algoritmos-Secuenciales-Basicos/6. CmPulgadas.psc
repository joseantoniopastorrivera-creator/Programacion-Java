Algoritmo CentimetrosPulgadas
	
	//Fecha 19 sept
	//Autor JAPR
	//Convertir cm a pulgadas
	
	//Parte declarativa
	Definir cm Como Real
	Definir pulgada Como Real
	
	//Cuerpo del Algoritmo
	Escribir "Indique los centímetros que desee convertir a pulgadas: "
	Leer cm
	pulgada <- cm * 2.54
	
	Escribir "La cantidad de centimetros que ha indicado corresponden a las siguientes pulgadas: ", pulgada
	
FinAlgoritmo
