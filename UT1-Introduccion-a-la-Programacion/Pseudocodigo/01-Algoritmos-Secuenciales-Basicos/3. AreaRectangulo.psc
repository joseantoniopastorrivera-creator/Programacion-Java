Algoritmo AreaRectangulo
	//Fecha 19 sept
	//Autor JAPR
	//Base de un rectángulo preguntando por sus lados
	
	//Parte declarativa
	Definir base Como Real
	Definir altura Como Real
	Definir area Como Real
	
	//Cuerpo del Algoritmo 
	Escribir "Vamos a calcular el área de un rectángulo. Introduzca la longitud de la base del mismo:"
	Leer base
	
	Escribir "Introduzca ahora su altura:"
	Leer altura
	
	area <- base * altura
	
	Escribir "El área del rectángulo es:" , area
	
	
FinAlgoritmo
